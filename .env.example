# Toutes ces clés sont OPTIONNELLES. Sans elles, le lab fonctionne quand
# même avec l'analyse statique + le modèle ML + un rapport basé template.

# VirusTotal (gratuit, quota limité) : https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# Google Safe Browsing (gratuit) : https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=

# URLhaus / abuse.ch (gratuit, obligatoire depuis juin 2025) : https://auth.abuse.ch/
# Connecte-toi, puis section "Optional" -> "Create Auth-Key"
URLHAUS_AUTH_KEY=

# Gemini — niveau gratuit disponible sur Google AI Studio : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek — alternative low-cost : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
